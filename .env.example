# Обязательные переменные
YOOKASSA_SHOP_ID='change_me'
YOOKASSA_API_KEY='change_me'

# ──────────────────────────────────────────────
# Авторизация в Мой Налог
# ──────────────────────────────────────────────
# Метод авторизации: 'password' (по умолчанию) или 'refresh'.
#   password — вход по ИНН и паролю (MOY_NALOG_LOGIN + MOY_NALOG_PASSWORD).
#   refresh  — вход по refreshToken (MOY_NALOG_REFRESH_TOKEN). Подходит для
#              аккаунтов, зарегистрированных через Госуслуги (без пароля).
MOY_NALOG_AUTH_METHOD='password'

# Для метода 'password' (обязательны оба):
MOY_NALOG_LOGIN='change_me'
MOY_NALOG_PASSWORD='change_me'

# Для метода 'refresh':
#   MOY_NALOG_REFRESH_TOKEN — бессрочный refreshToken из браузера.
#   Как получить: войдите на https://lknpd.nalog.ru через Госуслуги, откройте
#   DevTools браузера (F12) → вкладка Network (включите Preserve log) → найдите
#   запрос 'auth/esia' (или 'auth/token') → вкладка Response. В JSON-ответе
#   будут поля 'refreshToken' и 'deviceInfo.sourceDeviceId'.
#   refreshToken впишите в MOY_NALOG_REFRESH_TOKEN ниже, а sourceDeviceId —
#   в DEVICE_ID. (Альтернатива: те же значения есть в Application → Local Storage.)
#   ВАЖНО: refreshToken привязан к deviceId, поэтому в режиме refresh нужно
#   указать DEVICE_ID именно из браузера. MOY_NALOG_LOGIN/MOY_NALOG_PASSWORD
#   в этом режиме можно не задавать.
#MOY_NALOG_REFRESH_TOKEN='change_me'

# Таймзона контейнера. Используется для корректного времени в чеках и логах.
# Список: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ='Europe/Moscow'

# Опциональные переменные
# Специальный ID, используемый для идентификации устройства в Мой Налог (строго 21 символ).
# Если не задан, будет сгенерирован автоматически на основе MOY_NALOG_LOGIN.
# В режиме refresh укажите здесь deviceId из браузера (тот, для которого выдан
# refreshToken) — иначе авторизация по refreshToken не сработает.
#DEVICE_ID='CBDDvv8en4tprKHlqco4B'

# Дата начала синхронизации (YYYY-MM-DD). 
# Все платежи ДО этой даты (не включая эту дату) будут проигнорированы при первом запуске.
SYNC_START_DATE='2026-01-30'

# Шаблон описания дохода в Мой Налог.
# Доступные переменные для подстановки:
#   {id}                    — ID платежа в ЮКассе (UUID, например: 3126764a-000f-5001-8000-1ed54ebc90a7)
#   {description}           — описание платежа из ЮКассы, либо ID платежа если описания нет (обратная совместимость)
#   {payment_description}   — только описание платежа (пустая строка, если описания нет)
#   {order_number}          — номер счёта/заказа из ЮКассы (например: 1227418-1)
#   {invoice_id}            — ID счёта из invoice_details API (пустая строка, если нет)
#   {customer_name}         — название/имя из счёта ЮКассы (пустая строка, если нет)
#   {amount}                — сумма платежа
#   {merchant_customer_id}  — ID покупателя в вашей системе (пустая строка, если не задан)
#
# Примеры:
#   INCOME_DESCRIPTION_TEMPLATE='Платеж #{description}'
#   INCOME_DESCRIPTION_TEMPLATE='Оплата по счёту №{order_number}'
#   INCOME_DESCRIPTION_TEMPLATE='Оплата услуг: {description} ({amount} руб.)'
#   INCOME_DESCRIPTION_TEMPLATE='{customer_name} — счёт №{order_number}'
#
# Если не указано, используется значение по умолчанию: "Платеж #{description}"
INCOME_DESCRIPTION_TEMPLATE='Платеж #{description}'

# Расписание выполнения синхронизации в формате cron
CRON_SCHEDULE='0 */4 * * *'

# Отключение цветного вывода в логах (ANSI-цвета).
# По умолчанию логи в консоли цветные. Установите '1', если терминал/система
# просмотра логов не поддерживает ANSI-цвета и они мешают.
#NO_COLOR='1'

# ──────────────────────────────────────────────
# SOCKS5 прокси для российских сервисов (опционально)
# ──────────────────────────────────────────────
# Если сервер находится за пределами РФ, ФНС и/или ЮКасса могут блокировать
# зарубежные IP. В этом случае нужен SOCKS5-прокси с российским IP.
# Через этот прокси будут идти все запросы к api.yookassa.ru и lknpd.nalog.ru.
#
# ВАЖНО: используйте схему 'socks5h://' (с буквой h) — DNS-резолвинг будет
# происходить на стороне прокси-сервера, а не локально.
#
#YOOKASSA_NALOG_PROXY='socks5h://login:password@russian-vps-ip:1080'

# ──────────────────────────────────────────────
# Telegram-уведомления (опционально)
# ──────────────────────────────────────────────
# После каждой синхронизации бот отправляет итоговое сообщение в указанный чат/тред.
#
# Как получить значения:
#   TELEGRAM_BOT_TOKEN  — создайте бота через @BotFather, он выдаст токен
#   TELEGRAM_CHAT_ID    — числовой ID чата/группы (можно узнать через @userinfobot или @getidsbot)
#                         для личных сообщений обычно положительное число,
#                         для групп/каналов — отрицательное (например: -1001234567890)
#   TELEGRAM_THREAD_ID  — ID треда (топика) в супергруппе с включёнными темами.
#                         Оставьте закомментированным для отправки в основной чат.
#                         Получить: правой кнопкой на тему → Copy Link, число в конце URL.
#   TELEGRAM_PROXY      — SOCKS5 прокси, если сервер не имеет прямого доступа к api.telegram.org
#
#TELEGRAM_BOT_TOKEN='change_me'
#TELEGRAM_CHAT_ID='change_me'
#TELEGRAM_THREAD_ID='change_me'
#TELEGRAM_PROXY='socks5://login:password@ip:1080'

# ──────────────────────────────────────────────
# Email-уведомления (опционально)
# ──────────────────────────────────────────────
# Письмо приходит ТОЛЬКО при наличии новых платежей, возвратов или ошибок.
# Если новых событий нет — письмо не отправляется (в отличие от Telegram).
#
#   SMTP_HOST        — SMTP сервер (например: smtp.gmail.com, smtp.yandex.ru)
#   SMTP_PORT        — порт (обычно 587 для TLS или 465 для SSL)
#   SMTP_USER        — логин SMTP (как правило, почтовый адрес)
#   SMTP_PASSWORD    — пароль SMTP (для Gmail/Yandex — пароль приложения)
#   SMTP_FROM_EMAIL  — email отправителя (если не указан — используется SMTP_USER)
#   SMTP_FROM_NAME   — имя отправителя (отображается в почтовом клиенте)
#   SMTP_TO_EMAIL    — email получателя уведомлений
#   SMTP_USE_TLS     — использовать STARTTLS (true для порта 587, false для порта 465)
#   EMAIL_SUBJECT    — тема письма
#
#SMTP_HOST='smtp.gmail.com'
#SMTP_PORT='587'
#SMTP_USER='your_email@gmail.com'
#SMTP_PASSWORD='your_app_password'
#SMTP_FROM_EMAIL=''
#SMTP_FROM_NAME='YooKassa to MyNalog'
#SMTP_TO_EMAIL='your_inbox@example.com'
#SMTP_USE_TLS='true'
#EMAIL_SUBJECT='Синхронизация чеков в налоговой'
